# Copy to .env and fill in. .env is gitignored; this file is not, so no real values here.

# Set by compose.yaml for local Docker; set to the Neon URL when hosting.
# DATABASE_URL=postgres://ev:ev@db:5432/evcharger

# Port the HTTP server listens on (compose sets 3000; Render sets its own).
# PORT=3000

# Server only. Restrict to Places API (New); optional IP restriction; ~900 calls/month quota.
GOOGLE_PLACES_API_KEY=
# Sent to the browser for the map. Restrict to Maps JavaScript API, to
# http://localhost:3000/* (and the Render URL later), with a daily map-load cap.
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=
OPENCHARGE_API_KEY=
